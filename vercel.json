{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{Promptya_Site/assets/catalog.json,.server-ui/admin/**}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin-page"
    },
    {
      "source": "/admin/",
      "destination": "/api/admin-page"
    },
    {
      "source": "/admin/recadrage",
      "destination": "/api/admin-page?path=recadrage"
    },
    {
      "source": "/admin/recadrage/",
      "destination": "/api/admin-page?path=recadrage"
    },
    {
      "source": "/admin/recadrage/index.html",
      "destination": "/api/admin-page?path=recadrage"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin-page?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/worker",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/blog/:path*",
      "destination": "/fr/blog/:path*",
      "statusCode": 301
    },
